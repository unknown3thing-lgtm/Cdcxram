# =====================================================================
# CoinDCX Spot Lab — environment variables
# =====================================================================
# Copy this file to `.env` (local dev) or to your Vercel project's
# Environment Variables (Production / Preview / Development).
#
# This file contains ONLY variable names and safe placeholders. NEVER
# commit real secret values. The Supabase service-role key below is a
# placeholder — replace it with the real value from your Supabase
# dashboard, but only in your Vercel project settings or your local
# .env file (which is gitignored).
# =====================================================================

# ---------------------------------------------------------------------
# Supabase — required for the Vercel deployment
# ---------------------------------------------------------------------
# Your Supabase project URL (looks like https://<project>.supabase.co).
SUPABASE_URL="https://your-project.supabase.co"

# The publishable (anon) key. Safe to expose to the browser. Used by
# the static frontend for read-only requests and auth.
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_publishable_key_here"

# The service-role key. NEVER expose in browser code, NEVER commit.
# Only used by Vercel serverless functions (server-side) for trusted
# writes that bypass Row Level Security (e.g. the cron job that
# refreshes the market-data cache).
SUPABASE_SERVICE_KEY="sb_secret_your_service_role_key_here"

# ---------------------------------------------------------------------
# Scheduled refresh — required only if you enable the Vercel Cron job
# ---------------------------------------------------------------------
# A random secret string that the cron endpoint uses to authenticate
# the request. Generate with: openssl rand -hex 32
# Vercel Cron sends this in the `Authorization: Bearer <secret>` header.
CRON_SECRET="replace_with_openssl_rand_hex_32"

# ---------------------------------------------------------------------
# CORS — optional
# ---------------------------------------------------------------------
# If your static frontend is hosted on a different domain than the API,
# set this to the frontend's origin (e.g. https://coindcx-lab.vercel.app).
# Leave blank for same-origin (recommended when frontend + API share
# one Vercel project).
API_ALLOWED_ORIGIN=""

# ---------------------------------------------------------------------
# CoinDCX client tuning — all optional (defaults shown)
# ---------------------------------------------------------------------
# Override the public base URL if you need to point at a mirror.
COINDCX_BASE_URL="https://public.coindcx.com"
# Request timeout in seconds.
COINDCX_TIMEOUT="10"
# Max retry attempts for transient errors (timeouts, 5xx).
COINDCX_MAX_RETRIES="3"

# ---------------------------------------------------------------------
# Data-fallback policy — optional (default: true)
# ---------------------------------------------------------------------
# When live CoinDCX public data is unreachable (e.g. Cloudflare edge
# block on a data-centre IP), allow the dashboard to fall back to a
# clearly-labelled SIMULATED series. NEVER fabricates live prices.
# Set to "false" to disable the fallback entirely.
ALLOW_SIMULATED_WHEN_LIVE_UNAVAILABLE="true"
